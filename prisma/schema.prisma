generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  code      String    @unique
  products  Product[]

  @@index([name])
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  price           Float
  oldPrice        Float?
  stock           Int              @default(0)
  image           String
  isActive        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isNew           Boolean          @default(false)
  discountPercent Int?
  categoryId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productCode     String           @unique
  offers          Offer[]
  orderItems      OrderItem[]
  category        Category         @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]

  @@index([categoryId])
  @@index([productCode])
  @@index([isActive])
  @@index([isNew])
  @@index([isFeatured])
}

model Offer {
  id              String   @id @default(cuid())
  productId       String
  discountPercent Int
  newPrice        Float?
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  oldPrice        Float?
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([startDate])
  @@index([endDate])
}

model ProductVariant {
  id        String          @id @default(cuid())
  productId String
  sizeType  VariantSizeType @default(NONE)
  size      String?
  color     String?
  stock     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sizeType, size, color])
  @@index([productId])
  @@index([sizeType])
  @@index([size])
  @@index([color])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  wilaya    String
  commune   String
  address   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([phone])
}

model Order {
  id           String      @id @default(cuid())
  customerId   String
  status       OrderStatus @default(PENDING)
  subtotal     Float
  shippingCost Float       @default(0)
  discount     Float       @default(0)
  total        Float
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderNumber  Int         @unique @default(autoincrement())
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int
  color       String?
  size        String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum VariantSizeType {
  NONE
  LETTER
  NUMBER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
